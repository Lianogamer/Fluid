fn main() -> i64 {
    let name: str = "Fluid";
    print("Hello from");
    print(name);
    if name == "Fluid" {
        print("String comparison works.");
    }

    var count = 3;
    while count > 0 {
        print(count);
        count = count - 1;
    }

    for number in 1..4 {
        print(number);
    }

    let scores: [i64; 3] = [98, 87, 100];
    print(len(scores));
    print(scores[0]);
    print(len(name));
    print(abs(-7));
    print(min(3, 5));
    print(max(3, 5));
    print(clamp(12, 0, 10));
    print(sign(-7));
    print(pow(2.0, 3.0));
    print(sqrt(9.0));
    print(round(1.6));
    print(contains(name, "lui"));
    print(starts_with(name, "Fl"));
    print(ends_with(name, "id"));
    print(is_empty(""));
    assert(len(scores) == 3);
    return 0;
}
